generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountSnapshot {
  id           String     @id @default(cuid())
  mt5AccountId String
  balance      Decimal    @db.Decimal(15, 2)
  equity       Decimal    @db.Decimal(15, 2)
  profit       Decimal    @db.Decimal(15, 2)
  peakEquity   Decimal    @db.Decimal(15, 2)
  snapshotDate DateTime   @db.Date
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  mt5Account   MT5Account @relation(fields: [mt5AccountId], references: [id], onDelete: Cascade)

  @@unique([mt5AccountId, snapshotDate])
  @@index([mt5AccountId])
  @@index([snapshotDate])
}

model MT5Account {
  id                     String              @id @default(cuid())
  userId                 String
  accountId              String
  accountType            MT5AccountType
  broker                 String?
  server                 String?
  isConnected            Boolean             @default(false)
  lastHeartbeat          DateTime?
  balance                Decimal             @default(0) @db.Decimal(15, 2)
  equity                 Decimal             @default(0) @db.Decimal(15, 2)
  profit                 Decimal             @default(0) @db.Decimal(15, 2)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  apiKey                 String?             @unique
  allowSignalReceive     Boolean             @default(false)
  allowSignalSend        Boolean             @default(false)
  allowedMasterAccountId String?
  apiKeyLastUsedAt       DateTime?
  apiKeyPrefix           String?
  apiKeyRevokedAt        DateTime?
  maxDevices             Int                 @default(1)
  minEaVersion           String              @default("1.0.0")
  status                 MT5AccountStatus    @default(ACTIVE)
  accountSnapshots       AccountSnapshot[]
  allowedMasterAccount   MT5Account?         @relation("AllowedMasterAccount", fields: [allowedMasterAccountId], references: [id])
  allowedFollowers       MT5Account[]        @relation("AllowedMasterAccount")
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseSessions        MT5LicenseSession[]
  signals                Signal[]
  executions             SignalExecution[]

  @@unique([userId, accountId])
  @@index([accountId])
  @@index([apiKey])
  @@index([apiKeyPrefix])
  @@index([status])
  @@index([allowedMasterAccountId])
}

model MT5LicenseSession {
  id                  String           @id @default(cuid())
  userId              String
  mt5AccountId        String
  accountId           String
  broker              String?
  server              String?
  terminalFingerprint String
  deviceId            String?
  terminalId          String?
  ipAddress           String?
  eaType              MT5EaType
  eaVersion           String
  status              MT5SessionStatus @default(ACTIVE)
  expiresAt           DateTime?
  lastSeenAt          DateTime?
  lastHeartbeatAt     DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  mt5Account          MT5Account       @relation(fields: [mt5AccountId], references: [id], onDelete: Cascade)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mt5AccountId, eaType, terminalFingerprint])
  @@index([userId])
  @@index([mt5AccountId])
  @@index([terminalFingerprint])
  @@index([status])
  @@index([eaType])
}

model MonthlyReport {
  id               String   @id @default(cuid())
  userId           String
  year             Int
  month            Int
  totalSignals     Int      @default(0)
  executedSignals  Int      @default(0)
  winningTrades    Int      @default(0)
  losingTrades     Int      @default(0)
  totalProfit      Decimal  @default(0) @db.Decimal(15, 2)
  totalLoss        Decimal  @default(0) @db.Decimal(15, 2)
  netProfit        Decimal  @default(0) @db.Decimal(15, 2)
  endBalance       Decimal? @db.Decimal(15, 2)
  endEquity        Decimal? @db.Decimal(15, 2)
  subscriptionTier String?
  generatedAt      DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
}

model OTPToken {
  id        String    @id @default(cuid())
  userId    String
  code      String
  type      OTPType
  method    OTPMethod
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId, type])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique
  stripeInvoiceId String?
  description     String?
  metadata        Json?
  paidAt          DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([stripePaymentId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Signal {
  id           String            @id @default(cuid())
  providerId   String
  mt5AccountId String?
  action       SignalAction
  symbol       String
  type         TradeType
  volume       Decimal           @db.Decimal(10, 2)
  price        Decimal           @db.Decimal(15, 5)
  sl           Decimal?          @db.Decimal(15, 5)
  tp           Decimal?          @db.Decimal(15, 5)
  masterTicket BigInt?
  comment      String?
  magic        Int?
  status       SignalStatus      @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  mt5Account   MT5Account?       @relation(fields: [mt5AccountId], references: [id])
  provider     User              @relation(fields: [providerId], references: [id])
  executions   SignalExecution[]

  @@index([createdAt])
  @@index([providerId])
  @@index([status])
  @@index([symbol])
}

model SignalExecution {
  id             String          @id @default(cuid())
  signalId       String
  userId         String
  mt5AccountId   String?
  status         ExecutionStatus @default(PENDING)
  executedVolume Decimal?        @db.Decimal(10, 2)
  executedPrice  Decimal?        @db.Decimal(15, 5)
  slippage       Decimal?        @db.Decimal(15, 5)
  slaveTicket    BigInt?
  errorCode      Int?
  errorMessage   String?
  receivedAt     DateTime        @default(now())
  executedAt     DateTime?
  acknowledgedAt DateTime?
  mt5Account     MT5Account?     @relation(fields: [mt5AccountId], references: [id])
  signal         Signal          @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([signalId, userId])
  @@index([status])
  @@index([userId])
  @@index([mt5AccountId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tierId               String
  status               SubscriptionStatus @default(ACTIVE)
  billingCycle         BillingCycle       @default(MONTHLY)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tier                 SubscriptionTier   @relation(fields: [tierId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentPeriodEnd])
  @@index([status])
  @@index([userId])
}

model SubscriptionTier {
  id                 String         @id @default(cuid())
  name               String         @unique
  displayName        String
  description        String?
  priceMonthly       Decimal        @db.Decimal(10, 2)
  priceYearly        Decimal        @db.Decimal(10, 2)
  currency           String         @default("USD")
  stripePriceMonthly String?
  stripePriceYearly  String?
  maxSignalsPerDay   Int            @default(-1)
  maxSlaveAccounts   Int            @default(1)
  signalDelay        Int            @default(0)
  features           Json           @default("[]")
  isPopular          Boolean        @default(false)
  sortOrder          Int            @default(0)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscriptions      Subscription[]

  @@index([name])
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String?
  phone              String?
  avatar             String?
  emailVerified      Boolean             @default(false)
  emailVerifiedAt    DateTime?
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String?
  twoFactorMethod    TwoFactorMethod     @default(EMAIL)
  status             UserStatus          @default(ACTIVE)
  role               UserRole            @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastLoginAt        DateTime?
  lastLoginIp        String?
  mt5Accounts        MT5Account[]
  mt5LicenseSessions MT5LicenseSession[]
  monthlyReports     MonthlyReport[]
  otpTokens          OTPToken[]
  payments           Payment[]
  sessions           Session[]
  sentSignals        Signal[]
  executions         SignalExecution[]
  subscription       Subscription?

  @@index([email])
  @@index([status])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum ExecutionStatus {
  PENDING
  EXECUTED
  FAILED
  SKIPPED
  EXPIRED
}

enum MT5AccountStatus {
  ACTIVE
  BLOCKED
  REVOKED
  EXPIRED
  PENDING
}

enum MT5AccountType {
  MASTER
  SLAVE
}

enum MT5EaType {
  SENDER
  RECEIVER
}

enum MT5SessionStatus {
  ACTIVE
  STALE
  REVOKED
  BLOCKED
}

enum OTPMethod {
  EMAIL
  SMS
}

enum OTPType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_LOGIN
  PHONE_VERIFICATION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum SignalAction {
  OPEN
  CLOSE
  MODIFY
}

enum SignalStatus {
  PENDING
  ACTIVE
  EXECUTED
  EXPIRED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

enum TradeType {
  BUY
  SELL
}

enum TwoFactorMethod {
  EMAIL
  SMS
  TOTP
}

enum UserRole {
  USER
  PROVIDER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}
