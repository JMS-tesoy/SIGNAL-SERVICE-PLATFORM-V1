# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/signal_service?schema=public"

# =============================================================================
# JWT & SESSION
# =============================================================================
# Required: use a random value with at least 32 characters. Never use this example in production.
JWT_SECRET="replace-with-a-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="7d"
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN="30d"

# =============================================================================
# OTP SETTINGS
# =============================================================================
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# =============================================================================
# EMAIL (Resend)
# =============================================================================
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_APP="Signal Service App <noreply@tesoy.online>"
RESEND_FROM_AUTH="Signal Service Auth <auth@tesoy.online>"
RESEND_FROM_SUPPORT="Signal Service Support <support@tesoy.online>"
EMAIL_FROM="Signal Service App <noreply@tesoy.online>"
APP_URL="https://www.tesoy.online"
NEXT_PUBLIC_SITE_URL="https://www.tesoy.online"

# =============================================================================
# TWILIO (SMS)
# =============================================================================
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# =============================================================================
# STRIPE
# =============================================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# =============================================================================
# REDIS (for rate limiting & caching)
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# APP CONFIG
# =============================================================================
NODE_ENV="development"
PORT=3001
FRONTEND_URL="https://www.tesoy.online"
API_URL="http://localhost:3001"

# =============================================================================
# SECURITY
# =============================================================================
CORS_ORIGINS="https://www.tesoy.online"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5001
SIGNAL_RATE_LIMIT_WINDOW_MS=60000
SIGNAL_RATE_LIMIT_MAX_REQUESTS=60
